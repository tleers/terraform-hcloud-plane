domain      = "plane.example.com"
admin_email = "ops@example.com"

# Read this from a file when generating terraform.tfvars; never paste a private key.
ssh_public_key = "ssh-ed25519 AAAA... you@example.com"

# Discover your public IP with: curl -4 https://ifconfig.me
ssh_allowed_cidrs = ["203.0.113.10/32"]

# Defaults shown for clarity.
location       = "nbg1"
server_type    = "cax11"
swap_size_gb   = 2
image          = "ubuntu-24.04"
plane_version  = "v1.4.2"
enable_backups = true
enable_ipv6    = true
protect_server = true

labels = {
  environment = "production"
  owner       = "founders"
}
